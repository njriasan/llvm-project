declare void @sink(i8)

; TODO: Avoid reusing the OR-based multiply, which can be poison despite the
; inferred disjointness. For x = 127 and s = 1, the source returns 0 but the
; current SLSR output returns poison through the noundef return.
define noundef i8 @or_nsw_poison_reuse(i8 %x, i8 %s) {
; CHECK-LABEL: define noundef i8 @or_nsw_poison_reuse(
; CHECK-SAME: i8 [[X:%.*]], i8 [[S:%.*]]) {
; CHECK-NEXT:    [[A:%.*]] = and i8 [[X]], 127
; CHECK-NEXT:    [[B:%.*]] = add nsw i8 [[A]], 1
; CHECK-NEXT:    [[O:%.*]] = or i8 [[B]], -128
; CHECK-NEXT:    [[M0:%.*]] = mul i8 [[O]], [[S]]
; CHECK-NEXT:    [[F:%.*]] = freeze i8 [[M0]]
; CHECK-NEXT:    call void @sink(i8 [[F]])
; CHECK-NEXT:    ret i8 [[M0]]
;
  %a = and i8 %x, 127
  %b = add nsw i8 %a, 1
  %o = or i8 %b, -128
  %m0 = mul i8 %o, %s
  %f = freeze i8 %m0
  call void @sink(i8 %f)
  %bp = add i8 %a, 1
  %op = add i8 %bp, -128
  %m1 = mul i8 %op, %s
  ret i8 %m1
}
